# Untracked deploy config, read by deploy.sh in this same folder.
# Lives in the project root; gitignored by init and excluded from deployment.
# Trusted shell assignments only: deploy.sh sources this file.
#
# Fill in your server details, then set up KEY AUTH once so no password is ever needed:
#     ssh-copy-id -p 65002 YOUR_SSH_USER@YOUR_SERVER_HOST
#
# Do NOT put a password in this file.

DEPLOY_USER=YOUR_SSH_USER
DEPLOY_HOST=YOUR_SERVER_HOST
DEPLOY_PORT=65002
DEPLOY_REMOTE_PATH=/home/YOUR_SSH_USER/public_html/
